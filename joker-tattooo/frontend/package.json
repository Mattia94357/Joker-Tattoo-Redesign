{
  "name": "joker-tattooo-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "generate:seo": "node scripts/generate-seo.mjs",
    "audit:seo": "node scripts/audit-seo-output.mjs",
